# secrets
.envrc
.envrc.*
*.env
# editor swap/backup files (can hold secrets from open files)
*.swp
*.swo
*~
.*.sw?
# OS / tooling
.DS_Store
**/.DS_Store
.claude/
# python build/cache artifacts (regenerable)
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
# heavy / binary / re-derivable
Backups/
Downloads/
*.pdf
*.zip
*.sqlite
*.sqlite-*
*.xpi
# copyrighted full-texts (re-derivable from Zotero)
slr-phase4/txt/

# Zotero library exports — RDF + a files/ dir of the actual attachment PDFs.
# These land in the working tree with the export's own name (e.g.
# "Scalable AI Coding Governance - 2026-08-27 - Light Reads Completed/"), so
# Backups/ does not catch them. Multi-GB and copyrighted; the repo is PUBLIC.
*.rdf
**/files/
Scalable AI Coding Governance*/

# redundant binary spreadsheets (csv kept)
*.xls
*.xlsx
slr-phase4/data/critique/critique_input.md
slr-phase4/data/critique/*.raw
slr-phase4/data/critique/*.err
slr-phase4/data/critique/gemini_ka*.md

# F2 run outputs are regenerable model output, not source; the instrument and the
# expected-answers file ARE source and stay tracked.
slr-phase4/data/tags-f2/
slr-phase4/data/tags-f2-narrow/
